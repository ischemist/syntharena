// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid(2))
  username  String   @unique
  createdAt DateTime @default(now())
}

// =================================================================================
// 1. CHEMISTRY & TOPOLOGY (The "Graph" Layer)
// Matches retrocast.models.chem
// =================================================================================

model Molecule {
  id       String @id @default(cuid(2))
  inchikey String @unique // Molecular identity key used for relational deduplication
  smiles   String // Representative fallback; occurrence tables preserve exact input SMILES

  // Relations
  stockItems       StockItem[]
  routeNodes       RouteNode[]
  benchmarkTargets BenchmarkTarget[]

  @@index([smiles])
  @@index([inchikey, smiles])
}

// =================================================================================
// 2. BENCHMARKS (The "Exam" Layer)
// Matches retrocast.models.benchmark
// =================================================================================

enum BenchmarkSeries {
  MARKET // mkt-* for chemists
  REFERENCE // ref-* for developers
  LEGACY // random-* for Reviewer #3
  OTHER // future-proofing
}

model BenchmarkSet {
  id                  String  @id @default(cuid())
  name                String  @unique // e.g. "mkt-lin-500"
  description         String?
  stockId             String // Direct reference to the stock
  hasAcceptableRoutes Boolean @default(false) // All-or-nothing: targets either all have acceptable routes or none do
  sourcePath          String?
  sourceSha256        String?
  schemaVersion       String?
  defaultConstraintsJson String @default("[]")
  targetConstraintsJson  String @default("{}")

  createdAt DateTime @default(now())

  series   BenchmarkSeries @default(OTHER)
  isListed Boolean         @default(true) // for de-prioritizing -single-gt

  stock   Stock             @relation(fields: [stockId], references: [id])
  targets BenchmarkTarget[]
  runs    PredictionRun[]

  @@index([series, isListed, name]) // new index for fast filtering
}

model BenchmarkTarget {
  id             String @id @default(cuid())
  benchmarkSetId String
  targetId       String // The external ID, e.g. "n5-00123"
  moleculeId     String // The SMILES/InchiKey link
  smiles         String // Exact task-target representation

  // Metadata for stratification (cached from Python model)
  // These are computed from the PRIMARY acceptable route (index 0) if available
  routeLength  Int? // Length of primary acceptable route
  isConvergent Boolean? // Is primary acceptable route convergent?
  metadata     String? // JSON blob for other metadata

  // Relations
  benchmarkSet         BenchmarkSet          @relation(fields: [benchmarkSetId], references: [id])
  molecule             Molecule              @relation(fields: [moleculeId], references: [id])
  acceptableRoutes     AcceptableRoute[]
  predictionCandidates PredictionCandidate[]
  targetEvaluations    TargetEvaluation[]

  @@unique([benchmarkSetId, targetId])
  @@unique([id, benchmarkSetId])
}

// Junction table: Links BenchmarkTarget to multiple Route records (acceptable routes)
// Preserves array order from Python model via routeIndex (0 = primary route)
model AcceptableRoute {
  id                String @id @default(cuid())
  benchmarkTargetId String
  routeId           String
  routeIndex        Int // 0-based index in acceptable_routes array (0 = primary)

  target BenchmarkTarget @relation(fields: [benchmarkTargetId], references: [id], onDelete: Cascade)
  route  Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([benchmarkTargetId, routeId]) // One link per target-route pair
  @@unique([benchmarkTargetId, routeIndex]) // Index is unique per target
  @@index([benchmarkTargetId])
  @@index([routeId])
}

// =================================================================================
// 3. MODELS & EXECUTION (The "Prediction" Layer)
// Matches data/3-processed/
// =================================================================================

model Algorithm {
  id          String  @id @default(cuid())
  name        String  @unique // "DirectMultiStep"
  slug        String  @unique // "direct-multi-step" (for clean urls)
  description String? // high-level explanation of the method
  paper       String? // link to paper
  codeUrl     String? // link to canonical implementation
  bibtex      String? // bibtex citation string

  modelFamilies ModelFamily[]
}

model ModelFamily {
  id          String  @id @default(cuid())
  algorithmId String
  name        String  @unique // "SynPlanner MCTS Rollout"
  slug        String  @unique // "synplanner-mcts-rollout"
  description String?

  algorithm Algorithm       @relation(fields: [algorithmId], references: [id])
  instances ModelInstance[]

  @@index([algorithmId])
}

model ModelInstance {
  id            String  @id @default(cuid())
  modelFamilyId String
  slug          String  @unique // "dms-explorer-xl-v1-2-0"
  description   String? // what makes THIS version special? "trained on new internal dataset"

  // Structured SemVer
  versionMajor      Int     @default(0)
  versionMinor      Int     @default(0)
  versionPatch      Int     @default(0)
  versionPrerelease String @default("") // Empty string is the canonical stable release sentinel

  metadata  String? // JSON: training set info, hyperparams
  createdAt DateTime @default(now())

  family ModelFamily     @relation(fields: [modelFamilyId], references: [id])
  runs   PredictionRun[]

  @@unique([modelFamilyId, versionMajor, versionMinor, versionPatch, versionPrerelease])
  @@index([modelFamilyId])
}

enum SubmissionType {
  MAINTAINER_VERIFIED // run by us, hardware verified
  COMMUNITY_SUBMITTED // submitted by author, computationally verified
}

// Represents one "folder" in your data/3-processed structure
// e.g., data/3-processed/mkt-lin-500/dms-explorer-xl
model PredictionRun {
  id              String @id @default(cuid())
  modelInstanceId String
  benchmarkSetId  String

  // Provenance from Manifest
  retrocastVersion String?
  commandParams    String? // JSON of args
  executedAt       DateTime @default(now())

  // Cost tracking
  hourlyCost Float? // USD per hour (user-specified)
  totalCost  Float? // Pre-calculated: hourlyCost * (totalWallTime / 3600)

  // Planner execution timing from Pandora execution_stats.json.gz, summarized
  // in the verified RetroCast analysis artifact.
  executionStatsPath   String?
  executionStatsSha256 String?
  timedTargets         Int?
  totalWallTime        Float?
  totalCpuTime         Float?
  meanWallTime         Float?
  meanCpuTime          Float?

  // Candidate and route counts are recomputed after an artifact bundle import.
  totalCandidates Int    @default(0)
  totalFailures   Int    @default(0)
  totalRoutes     Int    @default(0)
  avgRouteLength  Float? // Average route length across all routes

  submissionType SubmissionType @default(COMMUNITY_SUBMITTED)
  isRetrained    Boolean? // for ref-* series. NULL = N/A, true/false for ref runs.

  modelInstance        ModelInstance         @relation(fields: [modelInstanceId], references: [id])
  benchmarkSet         BenchmarkSet          @relation(fields: [benchmarkSetId], references: [id])
  predictionCandidates PredictionCandidate[]
  evaluations          RunEvaluation[]

  @@unique([modelInstanceId, benchmarkSetId]) // Assuming one run per version per set
  @@unique([id, benchmarkSetId])
}

model Route {
  id String @id @default(cuid())

  // `signature` is topology-only and supports comparison. `contentHash` includes
  // exact producer provenance and is the deduplication identity.
  signature   String
  contentHash String @unique

  // Cached Computations (for fast filtering)
  length       Int
  isConvergent Boolean

  // Relations
  asAcceptableRouteFor AcceptableRoute[]
  nodes                RouteNode[]
  predictions          PredictionCandidate[] // One route can be predicted multiple times

  @@index([signature])
}

// One ranked planner output. A candidate contains exactly one of routeId or
// failureCode; the importer and database migration enforce this XOR invariant.
model PredictionCandidate {
  id              String  @id @default(cuid())
  routeId         String? // Present only when adaptation produced a route
  predictionRunId String // The model run that predicted this
  targetId        String // The target this prediction is for
  benchmarkSetId  String
  rank            Int // 1-indexed rank within this target/run

  metadata       String? // JSON: scores, confidence, etc. (prediction-specific)
  failureCode    String?
  failureMessage String?
  failureDetails String? // Full FailureRecord JSON

  // Relations
  route         Route?                @relation(fields: [routeId], references: [id], onDelete: Restrict)
  predictionRun PredictionRun         @relation(fields: [predictionRunId, benchmarkSetId], references: [id, benchmarkSetId], onDelete: Cascade)
  target        BenchmarkTarget       @relation(fields: [targetId, benchmarkSetId], references: [id, benchmarkSetId], onDelete: Cascade)
  evaluations   CandidateEvaluation[]

  // Constraints
  @@unique([predictionRunId, targetId, rank]) // Each rank is unique per target/run
  @@unique([id, predictionRunId, targetId, benchmarkSetId])
  @@index([targetId, rank])
  @@index([predictionRunId])
  @@index([routeId])
}

// Shared reaction topology used for visualization-level deduplication. Exact
// planner provenance belongs to each RouteNode occurrence below.
model ReactionStep {
  id           String @id @default(cuid())
  reactionHash String @unique // SHA256 of "productInchikey>>reactant1Inchikey.reactant2Inchikey" (sorted)

  nodes RouteNode[]
}

model RouteNode {
  id             String  @id @default(cuid())
  routeId        String
  moleculeId     String
  smiles         String // Exact producer representation for this route occurrence
  parentId       String? // Tree structure
  reactionStepId String? // null for leaf nodes
  template       String? // Exact producer template for this route occurrence
  metadata       String? // Exact mapped reaction/provenance for this occurrence

  isLeaf Boolean @default(false)

  // Relations
  route        Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  molecule     Molecule      @relation(fields: [moleculeId], references: [id])
  reactionStep ReactionStep? @relation(fields: [reactionStepId], references: [id])
  // Including routeId in the self-reference makes cross-route parenting
  // impossible even for direct SQL writes.
  parent       RouteNode?    @relation("ReactionTree", fields: [parentId, routeId], references: [id, routeId], onDelete: NoAction, onUpdate: NoAction)
  children     RouteNode[]   @relation("ReactionTree")

  @@unique([id, routeId])
  @@index([routeId])
  @@index([reactionStepId])
}

// =================================================================================
// 4. EVALUATION & METRICS (RetroCast schema-v2 evaluate bundles)
// =================================================================================

enum ReliabilityCode {
  OK // Reliable estimate
  LOW_N // Sample size too small (n < threshold)
  EXTREME_P // Probability near boundary (p very close to 0 or 1)
}

enum VendorSource {
  MC // Mcule
  LN // LabNetwork
  EM // eMolecules
  SA // Sigma Aldrich
  CB // ChemBridge
}

enum EvaluationStatus {
  PASS
  FAIL
  NOT_EVALUATED
}

model RunEvaluation {
  id               String   @id @default(cuid())
  predictionRunId  String
  benchmarkSetId   String
  stockId          String?
  metricLabel      String
  evaluatedTiers   String // JSON array; absence means unavailable, never failure
  taskJson         String
  parametersJson   String
  analysisJson     String // Canonical analysis report, including undisplayed MRR
  manifestJson     String
  manifestSha256   String   @unique
  artifactSchema   String
  retrocastVersion String
  createdAt        DateTime @default(now())

  predictionRun PredictionRun         @relation(fields: [predictionRunId, benchmarkSetId], references: [id, benchmarkSetId], onDelete: Cascade)
  stock         Stock?                @relation(fields: [stockId], references: [id])
  targets       TargetEvaluation[]
  candidates    CandidateEvaluation[]
  metrics       MetricEstimate[]

  @@unique([predictionRunId, metricLabel])
  @@unique([id, predictionRunId, benchmarkSetId])
  @@index([predictionRunId])
  @@index([stockId])
}

model TargetEvaluation {
  id              String @id @default(cuid())
  runEvaluationId String
  predictionRunId String
  targetId        String
  benchmarkSetId  String

  effectiveConstraintsJson String
  wallTime                 Float?
  cpuTime                  Float?

  runEvaluation RunEvaluation         @relation(fields: [runEvaluationId, predictionRunId, benchmarkSetId], references: [id, predictionRunId, benchmarkSetId], onDelete: Cascade)
  target        BenchmarkTarget       @relation(fields: [targetId, benchmarkSetId], references: [id, benchmarkSetId], onDelete: Cascade)
  candidates    CandidateEvaluation[]

  @@unique([runEvaluationId, targetId])
  @@unique([id, runEvaluationId, predictionRunId, targetId, benchmarkSetId])
  @@index([targetId])
}

model CandidateEvaluation {
  id                     String           @id @default(cuid())
  runEvaluationId        String
  targetEvaluationId     String
  predictionRunId        String
  targetId               String
  benchmarkSetId         String
  candidateId            String
  constraintStatus       EvaluationStatus
  constraintChecksJson   String?
  validityEvidenceJson   String? // Lossless non-summary evidence for Tier-1+ assessments
  matchesAcceptable      Boolean
  matchedAcceptableIndex Int?

  runEvaluation    RunEvaluation         @relation(fields: [runEvaluationId, predictionRunId, benchmarkSetId], references: [id, predictionRunId, benchmarkSetId], onDelete: Cascade)
  targetEvaluation TargetEvaluation      @relation(fields: [targetEvaluationId, runEvaluationId, predictionRunId, targetId, benchmarkSetId], references: [id, runEvaluationId, predictionRunId, targetId, benchmarkSetId], onDelete: Cascade)
  candidate        PredictionCandidate   @relation(fields: [candidateId, predictionRunId, targetId, benchmarkSetId], references: [id, predictionRunId, targetId, benchmarkSetId], onDelete: Cascade)
  tierResults      CandidateTierResult[]

  @@unique([runEvaluationId, candidateId])
  @@unique([targetEvaluationId, candidateId])
  @@index([candidateId])
}

model CandidateTierResult {
  id                    String           @id @default(cuid())
  candidateEvaluationId String
  tier                  Int
  status                EvaluationStatus
  checksJson            String?

  candidateEvaluation CandidateEvaluation @relation(fields: [candidateEvaluationId], references: [id], onDelete: Cascade)

  @@unique([candidateEvaluationId, tier])
  @@index([tier, status])
}

model MetricEstimate {
  id              String @id @default(cuid())
  runEvaluationId String
  metricKey       String // Exact RetroCast key, e.g. tier_0_validity_rate
  stratum         String @default("") // Empty for overall; otherwise exact artifact stratum

  // Metric values (stored as 0-1, convert to percentage in UI)
  value    Float
  ciLower  Float?
  ciUpper  Float?
  nSamples Int

  // Reliability assessment
  reliabilityCode    ReliabilityCode?
  reliabilityMessage String?

  // Relations
  runEvaluation RunEvaluation @relation(fields: [runEvaluationId], references: [id], onDelete: Cascade)

  @@unique([runEvaluationId, metricKey, stratum])
  @@index([metricKey, stratum])
}

// =================================================================================
// 5. SCORING & EVALUATION (The "Stock" Layer)
// Matches retrocast.models.evaluation and data/4-scored/
// =================================================================================

model Stock {
  id            String  @id @default(cuid(2))
  name          String  @unique // "buyables-stock" (matches directory name)
  description   String?
  sourcePath    String?
  sourceSha256  String?
  schemaVersion String?

  benchmarks  BenchmarkSet[]
  items       StockItem[]
  evaluations RunEvaluation[]
}

model StockItem {
  id         String @id @default(cuid(2))
  stockId    String
  moleculeId String
  smiles     String // Exact representation from this stock artifact

  // Commercial metadata (from buyables-meta.json.gz)
  ppg      Float? // Price per gram in USD
  source   VendorSource? // Vendor source
  leadTime String? // Lead time for delivery (e.g., '7-21days', '1week')
  link     String? // URL to vendor product page

  stock    Stock    @relation(fields: [stockId], references: [id])
  molecule Molecule @relation(fields: [moleculeId], references: [id])

  @@unique([stockId, moleculeId])
  @@index([stockId, source, ppg]) // covers vendor + price filtering
  @@index([stockId, ppg]) // covers price-only filtering
  @@index([stockId, moleculeId]) // optimize the join
}

model DatabaseMetadata {
  id                     String   @id @default("syntharena")
  databaseSchemaVersion  Int
  artifactSchemaVersion  String
  inventorySchemaVersion String
  inventorySha256        String
  retrocastVersion       String
  publicationStatus      String
  benchmarkCount         Int
  modelCount             Int
  expectedRunCount       Int
  importedRunCount       Int
  evaluationTargetCount  Int
  candidateCount         Int
  routeCount             Int
  failureCount           Int
  generatedAt            DateTime @default(now())
}
